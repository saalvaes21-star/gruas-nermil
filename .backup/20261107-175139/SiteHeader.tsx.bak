import { useEffect, useState } from "react";
import { Menu, X } from "lucide-react";
import { BrandLogo } from "@/components/site/BrandLogo";
import { Button } from "@/components/ui/button";

const links = [
  ["Unidad", "#unidad"],
  ["Servicios", "#servicios"],
  ["Cotizar", "#cotizar"],
  ["Cobertura", "#cobertura"],
  ["Contacto", "#contacto"],
] as const;
const SECTION_IDS = links.map(([, href]) => href.slice(1));
const leftLinks = links.slice(0, 2);
const rightLinks = links.slice(2);

function NavLink({
  label,
  href,
  isActive,
  onClick,
  variant,
}: {
  label: string;
  href: string;
  isActive: boolean;
  onClick?: () => void;
  variant: "desktop" | "mobile";
}) {
  const className =
    variant === "desktop"
      ? isActive
        ? "font-semibold text-industrial-yellow"
        : "text-warm-white/80 hover:text-warm-white"
      : `block py-3 text-sm font-semibold ${isActive ? "text-industrial-yellow" : "text-warm-white"}`;
  return (
    <a
      key={href}
      href={href}
      onClick={onClick}
      aria-current={isActive ? "location" : undefined}
      className={className}
    >
      {label}
    </a>
  );
}

export function SiteHeader() {
  const [compact, setCompact] = useState(false);
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState<string | null>(null);

  // Throttled to one update per frame instead of once per scroll event.
  useEffect(() => {
    let ticking = false;
    const applyCompact = () => {
      setCompact(window.scrollY > 40);
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(applyCompact);
      }
    };
    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") setOpen(false);
    };
    applyCompact();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("keydown", onKey);
    return () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("keydown", onKey);
    };
  }, []);

  useEffect(() => {
    const sections = SECTION_IDS.map((id) => document.getElementById(id)).filter(
      (el): el is HTMLElement => !!el,
    );
    if (!sections.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        setActive((current) => {
          const entering = entries.find((entry) => entry.isIntersecting);
          if (entering) return entering.target.id;
          const currentLeft = entries.some(
            (entry) => !entry.isIntersecting && entry.target.id === current,
          );
          return currentLeft ? null : current;
        });
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
    );
    sections.forEach((section) => observer.observe(section));
    return () => observer.disconnect();
  }, []);

  return (
    <header
      className="industrial-header sticky top-0 z-40 border-b border-white/10 bg-industrial-black/95 backdrop-blur"
      data-compact={compact}
    >
      <div
        className={`mx-auto grid max-w-6xl grid-cols-[1fr_auto_1fr] items-center gap-3 px-5 motion-safe:transition-[padding] motion-safe:duration-200 ${compact ? "py-2" : "py-3"}`}
      >
        <nav
          aria-label="Navegación principal"
          className="hidden justify-self-start gap-5 text-sm md:col-start-1 md:flex"
        >
          {leftLinks.map(([label, href]) => (
            <NavLink
              key={href}
              label={label}
              href={href}
              isActive={active === href.slice(1)}
              variant="desktop"
            />
          ))}
        </nav>

        <a
          href="#"
          onClick={() => setOpen(false)}
          aria-label="KING CENTRAL GRÚAS — inicio"
          className={`col-start-2 flex min-w-0 items-center justify-self-center motion-safe:transition-[width] motion-safe:duration-200 ${compact ? "w-24 md:w-28" : "w-28 md:w-36"}`}
        >
          <BrandLogo className="w-full h-auto" />
        </a>

        <div className="col-start-3 flex items-center justify-self-end gap-3">
          <nav
            aria-label="Navegación secundaria"
            className="hidden gap-5 text-sm md:flex"
          >
            {rightLinks.map(([label, href]) => (
              <NavLink
                key={href}
                label={label}
                href={href}
                isActive={active === href.slice(1)}
                variant="desktop"
              />
            ))}
          </nav>

          <Button
            variant="ghost"
            size="icon"
            className="size-11 shrink-0 text-warm-white hover:bg-white/10 md:hidden"
            aria-label={open ? "Cerrar menú" : "Abrir menú"}
            aria-expanded={open}
            aria-controls="mobile-navigation"
            onClick={() => setOpen((value) => !value)}
          >
            {open ? <X /> : <Menu />}
          </Button>
        </div>
      </div>
      {open && (
        <nav
          id="mobile-navigation"
          aria-label="Navegación móvil"
          className="absolute inset-x-0 top-full border-b border-white/10 bg-industrial-black px-5 py-2 md:hidden"
        >
          <div className="mx-auto max-w-6xl divide-y divide-white/10">
            {links.map(([label, href]) => (
              <NavLink
                key={href}
                label={label}
                href={href}
                isActive={active === href.slice(1)}
                variant="mobile"
                onClick={() => setOpen(false)}
              />
            ))}
          </div>
        </nav>
      )}
    </header>
  );
}
